// Tropa Livresca — Banco de Dados
// Campos sem [not null] aceitam valores nulos.
// IDs varchar(15) são gerados pelo PocketBase, não são autoincrementos numéricos.

Table users_profile {
  id varchar(15) [pk, not null]
  email varchar [not null, unique]
  emailVisibility boolean
  verified boolean
  nome text
  sobrenome text
  descricao text
  redes_sociais json
  is_admin boolean
  senha_admin text
  primeiro_acesso boolean
  is_master boolean
  dados_bancarios json
  imagem file
  telefone text
  created timestamp
  updated timestamp
}

Table avaliacoes {
  id varchar(15) [pk, not null]
  data_criacao date [not null]
  qtd_estrelas decimal
  fk_livros_id varchar(15)
  fk_user_profile_id varchar(15)
}

Table enderecos {
  id varchar(15) [pk, not null]
  estado text [not null]
  bairro text [not null]
  rua text [not null]
  num decimal [not null]
  cep text [not null]
  cidade text [not null]
  complemento text
  pais text
  ativo boolean
  principal boolean
  fk_user_profile_id varchar(15)
}

Table itens_venda {
  id varchar(15) [pk, not null]
  qtd decimal [not null]
  subtotal decimal [not null]
  fisico boolean
  preco_unitario decimal [not null]
  fk_livros_itens_id varchar(15) [not null]
  fk_vendas_id varchar(15) [not null]
}

Table livros {
  id varchar(15) [pk, not null]
  direitos_de_publicacao boolean
  data_de_publicacao date [not null]
  preco_digital decimal [not null]
  preco_fisico decimal [not null]
  titulo text [not null]
  subtitulo text [not null]
  descricao text [not null]
  ativo boolean
  estado text [not null]
  idioma text [not null]
  colaboradores json
  categoria text
  ISBN text
  numero_paginas decimal
  manuscrito file
  capa_frente file
  capa_verso file
  fk_user_profile_id varchar(15)
}

Table movimentacoes_financeiras {
  id varchar(15) [pk, not null]
  data date [not null]
  tipo text [not null]
  valor decimal [not null]
  descricao text [not null]
  status text [not null]
  fk_vendas_id varchar(15)
  dados_bancarios json
  fk_user_profile_id varchar(15)
}

Table revisoes {
  id varchar(15) [pk, not null]
  apontamento text
  nome text
  completado boolean
  fk_livro_id varchar(15) [not null]
  fk_user_profile_id varchar(15)
  arquivo file
  fk_autor_id varchar(15) [not null]
  data_criacao timestamp
}

Table vendas {
  id varchar(15) [pk, not null]
  data date [not null]
  total decimal [not null]
  metodo_pagamento decimal [not null]
  status_pagamento text [not null]
  endereco_entrega json
  status_entrega text [not null]
  fk_user_profile_id varchar(15)
}

// Relacionamentos

Ref: avaliacoes.fk_livros_id > livros.id
Ref: avaliacoes.fk_user_profile_id > users_profile.id

Ref: enderecos.fk_user_profile_id > users_profile.id

Ref: itens_venda.fk_livros_itens_id > livros.id
Ref: itens_venda.fk_vendas_id > vendas.id

Ref: movimentacoes_financeiras.fk_vendas_id > vendas.id
Ref: movimentacoes_financeiras.fk_user_profile_id > users_profile.id

Ref: revisoes.fk_livro_id > livros.id
Ref: revisoes.fk_user_profile_id > users_profile.id
Ref: revisoes.fk_autor_id > users_profile.id

Ref: vendas.fk_user_profile_id > users_profile.id